# Sal secreta para seudonimizar el NIT (HMAC-SHA256). No la subas a Git.
NIT_SALT=cambia-esta-sal-por-una-cadena-larga-y-aleatoria

FLASK_SECRET_KEY=cambia-esto
FLASK_DEBUG=1
MAX_UPLOAD_MB=200
